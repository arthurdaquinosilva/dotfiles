#!/usr/bin/env bash

# Configuration
COMMANDS_HISTORY_FILE="/Volumes/PortableSSD/programming/commands_history.txt"

copy_history() {
  # Create the directory if it doesn't exist
  mkdir -p "$(dirname "$COMMANDS_HISTORY_FILE")"

  # Append new history entries to the file
  # Filter out empty lines and ensure each entry is on a new line
  cut -d";" -f2 ~/.zsh_history | grep -v '^[[:space:]]*

copy_history
